{
  "name": "herder-vscode",
  "displayName": "Herder",
  "description": "Completion and validation for Herder config repos: parameter paths from the live schema repository, canonical names, and exact-parity validation of YAML and scripts",
  "version": "0.1.2",
  "publisher": "ispx",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ispx-limited/herder-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:typescript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Herder",
      "properties": {
        "herder.apiUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Herder API, e.g. https://acs.example.net. Empty disables API-backed features."
        },
        "herder.metaBaseUrl": {
          "type": "string",
          "default": "https://docs.herder.ispx.co/schemas",
          "description": "Where kinds.json and reserved-canonicals.json are fetched from. The default is the public docs site; point it at your own if you run a fork."
        },
        "herder.scriptDomains": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "**/provisioning/**": "provisioning",
            "**/actions/**": "actions",
            "**/topology/**": "telemetry_enrichment",
            "**/enrichment/**": "telemetry_enrichment"
          },
          "description": "Glob to config domain, deciding which domain a .ts script validates against. First match wins; unmatched scripts use provisioning."
        },
        "herder.validateOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Validate the buffer against the API as you type (debounced). Off validates on save only."
        }
      }
    },
    "commands": [
      {
        "command": "herder.setToken",
        "title": "Herder: Set API Token"
      },
      {
        "command": "herder.clearToken",
        "title": "Herder: Clear API Token"
      },
      {
        "command": "herder.validateFile",
        "title": "Herder: Validate Current File"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.4.0"
  }
}
